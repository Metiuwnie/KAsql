Options -Indexes

# ================================================================
# Security Hardening: Block access to sensitive files
# ================================================================
<FilesMatch "(^\.|\.(env|sql|log|md|json|lock|git|yml|yaml|ini|bak|swp)$)">
    Order allow,deny
    Deny from all
</FilesMatch>

RewriteEngine On

# Allow direct access ONLY to safe static assets if they exist
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot)$ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route all application requests to index.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
